PORT=5000
NODE_ENV=development
# Replace with your MongoDB connection string (e.g., local MongoDB or MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/codealpha_ecommerce
MONGODB_URI=mongodb://127.0.0.1:27017/codealpha_ecommerce
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters_long
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:5173
